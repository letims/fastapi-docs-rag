# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql://docsrag:docsrag@localhost:5433/docsrag

# Which vendor serves each role. Defaults: Voyage for embeddings and reranking, Groq for answers.
# PROVIDER (one value for both roles, e.g. fake or gemini) overrides the defaults; EMBED_PROVIDER / LLM_PROVIDER override that.
#   embeddings: gemini | voyage | fake      LLM: gemini | groq | openai_compat | fake
# PROVIDER=
EMBED_PROVIDER=voyage
LLM_PROVIDER=groq

# Keys go HERE and nowhere else (this file is gitignored; never paste them in chat, issues or commits).
VOYAGE_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# Model IDs change often: confirm the exact strings in each provider's console before the first run.
VOYAGE_EMBED_MODEL=voyage-4-lite
VOYAGE_RERANK_MODEL=rerank-2.5-lite
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_LLM_MODEL=gemini-3.1-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-2
# Any other OpenAI-compatible API (GitHub Models, OpenRouter, ...): LLM_PROVIDER=openai_compat
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# Vector size. Voyage allows 256 | 512 | 1024 | 2048 (1024 recommended); Gemini accepts 768.
# CHANGING THIS (or the embedding model) MEANS A FRESH DATABASE: `make down`, remove the volume, `make up`.
EMBED_DIM=1024

EMBED_BATCH_SIZE=64
WORKER_CONCURRENCY=4
JOB_MAX_ATTEMPTS=5
JOB_VISIBILITY_TIMEOUT_S=300

# --- Retrieval ---
# vector | hybrid (vector + full-text, fused with RRF) | rerank (hybrid candidates, then a cross-encoder).
# This is what `make api` uses; `make eval MODE=...` picks per run. Measure before changing the default.
RETRIEVAL_MODE=vector
RERANK_CANDIDATES=20
# Phase 3 agent loop (POST /ask with {"agent": true}, or AGENT_DEFAULT=true to make it the default).
AGENT_DEFAULT=false
AGENT_MAX_ROUNDS=3
AGENT_TOKEN_BUDGET=12000
AGENT_PER_QUERY=3
AGENT_CONTEXT_EXTRA=4
# voyage | fake. Empty = voyage (fake when embeddings are fake).
# RERANK_PROVIDER=

# --- API quotas ---
# Leave these commented out to use the built-in preset for your provider (see QUOTA_PRESETS in
# app/config.py). Uncomment and edit to match what YOUR console shows:
#   Voyage (no card): 3 RPM / 10K TPM, a batch counts as 1 request.  Groq gpt-oss: 30 RPM / 8K TPM / 1K RPD
#   (plus 200K tokens/day, not modeled).  Gemini free: 60 RPM / 100K TPM / 100 RPD.
# EMBED_RPM=
# EMBED_TPM=
# EMBED_RPD=
# LLM_RPM=
# LLM_TPM=
# LLM_RPD=
# Rerank follows the Voyage no-card numbers until you confirm yours (one request per question):
# RERANK_RPM=
# RERANK_TPM=
# RERANK_RPD=
# "text" = every text in a batch counts as one request (safe); "call" = one batch is one request.
# EMBED_QUOTA_UNIT=
# Persistent cache: identical embeddings / LLM prompts are never paid for twice. Set false for final measurements.
API_CACHE=true
API_CACHE_PATH=.cache/api_cache.sqlite
