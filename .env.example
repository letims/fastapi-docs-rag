# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql://ragnarok:ragnarok@localhost:5433/ragnarok

# "gemini" (free tier via Google AI Studio) or "fake" (offline, deterministic, for tests/dev)
PROVIDER=gemini
GEMINI_API_KEY=
# Model IDs change often: confirm the exact strings in AI Studio before the first run.
GEMINI_LLM_MODEL=gemini-3.1-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-2
EMBED_DIM=768

EMBED_BATCH_SIZE=64
WORKER_CONCURRENCY=4
JOB_MAX_ATTEMPTS=5
JOB_VISIBILITY_TIMEOUT_S=300
