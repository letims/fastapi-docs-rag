#!/usr/bin/env bash
# Runs before every `git commit`. Any failure blocks the commit.
# Install once per clone with `make install-hooks`. Emergency bypass: git commit --no-verify
# (CI runs the same checks, so a bypassed commit still cannot merge broken).
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

staged="$(git diff --cached --name-only --diff-filter=ACMR)"
[ -z "$staged" ] && exit 0

fail() { echo "pre-commit: BLOCKED - $1" >&2; exit 1; }

# 1. Secrets never go into git: the .env file itself, and key-shaped strings in added lines.
if echo "$staged" | grep -Eq '(^|/)\.env$'; then
  fail ".env is staged. Unstage it: git restore --staged .env"
fi
# Voyage (pa-...), Groq (gsk_...), Google (AIza...), OpenAI-style (sk-...) key shapes.
if git diff --cached -U0 | grep -E '^\+' | grep -Eq 'pa-[A-Za-z0-9_-]{30,}|gsk_[A-Za-z0-9]{20,}|AIza[0-9A-Za-z_-]{30,}|sk-[A-Za-z0-9]{30,}'; then
  fail "an added line looks like an API key. Remove it (and rotate the key if it was ever pushed)"
fi

# 2. Lint, format and tests only matter when code or its config changed (docs-only commits skip them).
if echo "$staged" | grep -Eq '\.(py|toml|lock|sql|sh|yml|yaml)$|^Makefile$|^\.githooks/'; then
  echo "pre-commit: ruff check"
  uv run ruff check . || fail "lint errors (try: make fmt)"
  echo "pre-commit: ruff format --check"
  uv run ruff format --check . || fail "unformatted files (run: make fmt)"
  echo "pre-commit: tests + 90% coverage gate"
  uv run pytest -q --cov --cov-report=term:skip-covered || fail "tests failed or coverage is under 90%"
fi
echo "pre-commit: all checks passed"
